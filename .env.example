# Copy to .env. The installer writes this file for you.

# Where the container listens inside the network. Leave it alone.
BRIDGE_PORT=8787

# Which host address the published port binds to.
#   127.0.0.1  reachable only from the server itself, for a reverse proxy
#   0.0.0.0    reachable from anywhere the firewall allows
BRIDGE_BIND=127.0.0.1

# Encrypts the Claude account tokens in the database. Generate with:
#   openssl rand -base64 48
BRIDGE_SECRET_KEY=

# Model used when a request does not name one, or names one the bridge
# does not know and BRIDGE_UNKNOWN_MODEL is "map".
BRIDGE_DEFAULT_MODEL=claude-opus-5

# What to do with an unknown model name.
#   map    use the default model and report it back in the response
#   error  answer with 400 and list the known names
BRIDGE_UNKNOWN_MODEL=map

# How many Claude Code processes may run at once, and how long a request may
# wait for a free slot before the bridge answers 503.
BRIDGE_MAX_CONCURRENT=4
BRIDGE_QUEUE_TIMEOUT_MS=30000

# Hard stop for a single run.
BRIDGE_REQUEST_TIMEOUT_MS=600000

# How long an account is parked after it hits a limit or fails to authenticate.
BRIDGE_ACCOUNT_COOLDOWN_MS=900000

# Request rows older than this are deleted. 0 keeps them forever.
BRIDGE_RETENTION_DAYS=90

# error, warn, info or debug
BRIDGE_LOG_LEVEL=info

# Which Claude Code version the image is built with.
CLAUDE_CODE_VERSION=2.1.278
