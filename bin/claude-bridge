#!/usr/bin/env bash
# Wrapper around the container. Anything it does not handle itself goes to the
# CLI inside the container.
set -euo pipefail

DIR="${CLAUDE_BRIDGE_DIR:-/opt/claude-api-bridge}"
SERVICE=bridge

if [ ! -f "$DIR/docker-compose.yml" ]; then
  echo "claude-bridge: no installation at $DIR" >&2
  echo "Set CLAUDE_BRIDGE_DIR if you installed somewhere else." >&2
  exit 1
fi

cd "$DIR"

COMPOSE_FILES=(-f docker-compose.yml)
# shellcheck source=/dev/null
[ -f .bridge-profile ] && . ./.bridge-profile
[ "${BRIDGE_PROFILE:-}" = "caddy" ] && COMPOSE_FILES+=(-f docker-compose.caddy.yml)

compose() {
  docker compose "${COMPOSE_FILES[@]}" "$@"
}

running() {
  [ -n "$(compose ps -q "$SERVICE" 2>/dev/null)" ]
}

in_container() {
  if ! running; then
    echo "claude-bridge: the container is not running. Start it with: claude-bridge start" >&2
    exit 1
  fi
  compose exec -T "$SERVICE" node src/cli.mjs "$@"
}

# Newest published Claude Code, unless .env pins a version.
cli_version() {
  local pinned found
  pinned="$(grep -E '^CLAUDE_CODE_VERSION=' .env 2>/dev/null | cut -d= -f2- || true)"
  if [ -n "$pinned" ] && [ "$pinned" != "latest" ]; then
    printf '%s' "$pinned"
    return
  fi
  found="$(curl -fsSL https://registry.npmjs.org/@anthropic-ai/claude-code/latest 2>/dev/null \
    | grep -o '"version":"[^"]*"' | head -1 | cut -d'"' -f4)"
  printf '%s' "${found:-latest}"
}

build() {
  local version
  version="$(cli_version)"
  echo "Building with Claude Code $version" >&2
  compose build --pull --build-arg "CLAUDE_CODE_VERSION=$version"
}

read_token() {
  # Typed in, it should not reach the shell history or the screen. Piped in, it
  # is used as is.
  if [ -t 0 ]; then
    echo "Paste the token from 'claude setup-token' (input is hidden):" >&2
    local token
    read -rs token
    echo >&2
    printf '%s' "$token"
  else
    cat
  fi
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  start|up)
    compose up -d
    ;;
  stop|down)
    compose stop
    ;;
  restart)
    compose restart
    ;;
  rebuild)
    build
    compose up -d
    ;;
  update)
    if [ ! -d .git ]; then
      echo "claude-bridge: $DIR is not a git checkout, so there is nothing to pull." >&2
      echo "Run install.sh once more from a fresh clone. Keys, accounts and stats stay." >&2
      exit 1
    fi
    git -c safe.directory="$DIR" pull --ff-only
    build
    compose up -d
    # A new version can bring a new wrapper too.
    if [ -w "$0" ] && [ "$(realpath "$0")" != "$DIR/bin/claude-bridge" ]; then
      install -m 0755 bin/claude-bridge "$0"
    fi
    compose ps
    ;;
  logs)
    if [ $# -eq 0 ]; then
      compose logs --tail=100 "$SERVICE"
    else
      compose logs "$@" "$SERVICE"
    fi
    ;;
  ps)
    compose ps
    ;;
  health)
    port="$(grep -E '^BRIDGE_PORT=' .env 2>/dev/null | cut -d= -f2)"
    curl -fsS "http://127.0.0.1:${port:-8787}/health" && echo
    ;;
  shell)
    compose exec "$SERVICE" bash
    ;;
  accounts)
    sub="${1:-list}"
    if [ "$sub" = "add" ] || [ "$sub" = "token" ]; then
      read_token | compose exec -T "$SERVICE" node src/cli.mjs accounts "$@"
    else
      in_container accounts "$@"
    fi
    ;;
  version|-v|--version)
    echo "installation  $DIR"
    printf 'bridge        %s\n' "$(in_container version)"
    printf 'claude code   %s\n' "$(compose exec -T "$SERVICE" claude --version 2>/dev/null || echo '?')"
    ;;
  help|-h|--help)
    cat <<'USAGE'
claude-bridge - manage the Claude API Bridge

Container
  start | stop | restart      run, halt, restart the service
  rebuild                     rebuild with the newest Claude Code, restart
  update                      pull the repo, rebuild, restart
  logs [-f] [--tail=N]        container logs
  ps | health | shell         state, health endpoint, a shell inside

Service
  status                      current settings and counts
  stats [--days N] [--json]   usage over a period
  recent [-n 20]              the last requests
  keys ...                    manage API keys
  accounts ...                manage Claude account tokens

Run "claude-bridge keys" or "claude-bridge accounts" for their options.
USAGE
    ;;
  *)
    in_container "$cmd" "$@"
    ;;
esac
